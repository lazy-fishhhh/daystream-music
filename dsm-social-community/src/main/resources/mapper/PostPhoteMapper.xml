<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="social.mapper.PostPhoneMapper">
    <select id="selectPhotes" resultType="String">
        select photo_url
        from post_photos
        where post_id
        in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        order by sort_order
    </select>
    <select id="selectPhote" resultType="String">
        select photo_url
        from post_photos
        where post_id=#{postId}
        order by sort_order
    </select>
    <delete id="deleteByPostId">
            delete from post_photos where post_id=#{postId}
    </delete>
    <delete id="deleteByPhotoUrl">
        delete from post_photos
        where photo_url=#{photoUrl}
        and post_id=#{postId}
    </delete>
</mapper>