<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="social.mapper.LikeRecord1Mapper">

    <!-- 批量查询多个用户的点赞记录 -->
    <select id="selectLikeSongsByUserIds" resultType="map">
        select
        user_id as `key`,
        GROUP_CONCAT(DISTINCT target_id SEPARATOR ',') as `value`
        from like_record
        where user_id in
        <foreach collection="userIds" item="userId" open="(" close=")" separator=",">
            #{userId}
        </foreach>
        and target_type = 1
        and is_canceled = 0
        group by user_id
    </select>

</mapper>